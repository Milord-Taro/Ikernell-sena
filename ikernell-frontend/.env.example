# Copia este archivo como ".env" en la raíz de ikernell-frontend/ y ajusta
# los valores según tu entorno. El archivo ".env" real está ignorado por
# Git (ver .gitignore) porque puede variar entre máquinas.

# URL base del backend (incluyendo el prefijo /api).
# Debe apuntar al backend de ikernell-backend corriendo localmente o al
# entorno que estés usando (dev/staging).
VITE_API_URL=http://localhost:8080/api
